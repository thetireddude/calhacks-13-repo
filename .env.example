# Gather — local environment template (do not commit real secrets)
# Full Dev 2 setup: docs/dev2-local-setup.md
# After `supabase start`, copy values from: supabase status

# --- Supabase (Developer 2) — from `supabase status` ---
# API URL          → SUPABASE_URL
# anon key         → SUPABASE_ANON_KEY
# service_role key → SUPABASE_SERVICE_ROLE_KEY
# JWT secret       → SUPABASE_JWT_SECRET (required for API bearer auth locally)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Optional Gate 2 JWT hardening (only when testing iss/aud validation)
# Local issuer is typically http://127.0.0.1:54321/auth/v1
# SUPABASE_JWT_ISSUER=
# SUPABASE_JWT_AUDIENCE=authenticated

# --- API (Developer 2) ---
# apps/api binds PORT (default 3000); API_* vars are for docs and mobile alignment
PORT=3000
HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000

# --- Mobile (Developer 1) — Expo public vars must be EXPO_PUBLIC_* ---
# EXPO_PUBLIC_SUPABASE_URL = same as SUPABASE_URL
# EXPO_PUBLIC_SUPABASE_ANON_KEY = same as SUPABASE_ANON_KEY
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Planner providers (Developer 3) — optional until real planner integration ---
CREAO_API_KEY=
BRIGHT_DATA_API_KEY=
